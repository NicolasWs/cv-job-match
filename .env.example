# Copy this file to .env (same folder) and fill in your real keys.
# .env is git-ignored — it will never be committed.
#
# Only ANTHROPIC_API_KEY is required. The others are optional fallbacks:
# if your selected model's provider fails (bad/expired key, rate limit,
# outage), the app automatically retries with the next configured provider.

ANTHROPIC_API_KEY=sk-ant-...

# Fallback providers (optional — leave blank/omit to skip)
MISTRAL_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
