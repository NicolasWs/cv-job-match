# Copy this file to .env (repo root) and fill in your real keys.
# .env is git-ignored — it will never be committed.
#
# The control panel (webapp/) needs ONE of these three provider keys — set the
# one you have and select the matching provider in the Settings panel (or via
# LLM_PROVIDER below). The old app/ v1 also reads ANTHROPIC_API_KEY if set.

MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # GOOGLE_API_KEY also accepted

# Which provider the webapp uses: mistral | openai | google
LLM_PROVIDER=mistral

# Optional model overrides (defaults are per-provider, see webapp/README.md)
SCORING_MODEL=
PACKAGE_MODEL=

# Apify token — only needed for on-demand "Fresh Apify scrape" in Run my week
APIFY_TOKEN=

# Legacy v1 app (app/server.py) — optional
ANTHROPIC_API_KEY=
